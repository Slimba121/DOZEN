# ── Local / Vercel ──

# false = live Hub on Base (required on Vercel production)
NEXT_PUBLIC_PREVIEW_MODE=false

# Required — leaderboard + referrals API (Alchemy recommended)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Required for rank badge mint API — key for 0xAD52cDAaFD927f5548d4347B7300bA8710d3E6A4
BADGE_RANK_SIGNER_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# Optional — faster leaderboard indexing (default in contract.ts: 46822901)
# HUB_DEPLOY_FROM_BLOCK=46822901

# Optional — override builder code (default in app.ts: bc_wnu57oz2)
# NEXT_PUBLIC_BASE_BUILDER_CODE=bc_wnu57oz2

# ── Local deploy only (never commit to git) ──
# PRIVATE_KEY=0x...
# RANK_SIGNER=0x...
# ETHERSCAN_API_KEY=...
